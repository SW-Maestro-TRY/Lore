# new_harness 의 .env — 이 파일을 .env 로 복사해서 쓰세요.
#
# API 키는 여기 안 적어도 됩니다. story-harness/.env 를 뒤이어 읽으므로
# 거기 있는 GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY 를 그대로
# 물려받습니다. 여기서 정하는 것은 **어느 단계를 어느 모델로 돌릴지** 입니다.
#
# 우선순위:  <단계>_PROVIDER / <단계>_MODEL  >  NH_PROVIDER / NH_MODEL  >  PROVIDER
# 단계 이름:  STORY(이야기 후보) · BOARD(콘티) · SHEET(시트 사양)
#
# 값 뒤에 주석을 붙이지 마세요 — 주석까지 값으로 읽힙니다
# (story-harness/.env 와 같은 파서입니다).

# ── 이 하네스 전체 기본 ────────────────────────────────
NH_PROVIDER=gemini

# 비우면 provider 의 기본 모델을 씁니다.
# NH_MODEL=

# ── 단계마다 다른 모델 (필요한 줄만 켜세요) ─────────────
# STORY_PROVIDER=openai
# STORY_MODEL=gpt-5.1
# BOARD_PROVIDER=gemini
# BOARD_MODEL=gemini-3-pro-preview
# SHEET_PROVIDER=anthropic
# SHEET_MODEL=claude-opus-5

# ── 시트 이미지 (gemini | openai) ──────────────────────
SHEET_IMAGE_PROVIDER=gemini

# 비우면 GEMINI_IMAGE_MODEL / OPENAI_IMAGE_MODEL 을 씁니다.
# SHEET_IMAGE_MODEL=

# openai 로 그릴 때만 씁니다 (low | medium | high).
# OPENAI_IMAGE_QUALITY=high

# ── 공통 ───────────────────────────────────────────────
NH_MAX_TOKENS=16000
NH_TEMPERATURE=0.9

# new_harness 의 .env — 이 파일을 .env 로 복사해서 쓰세요.
#
#   cp .env.example .env
#   python3 run.py --plan       # 지금 어느 단계가 어느 모델로 도는지
#
# ─────────────────────────────────────────────────────────────────────
# API 키는 여기 적지 마세요.
#
# new_harness/.env 를 먼저 읽고 story-harness/.env 를 뒤이어 읽는데, 둘 다
# "이미 있는 값은 안 덮어쓴다" 라서 거기 있는 키를 그대로 물려받습니다:
#
#   GEMINI_API_KEY · OPENAI_API_KEY · ANTHROPIC_API_KEY
#   GEMINI_BASE_URL · OPENAI_BASE_URL · ANTHROPIC_BASE_URL
#
# 여기서 정하는 것은 **어느 단계를 어느 모델로 돌릴지** 뿐입니다.
# ─────────────────────────────────────────────────────────────────────
#
# 값 뒤에 주석을 붙이지 마세요 — 주석까지 값으로 읽힙니다
# (story-harness/.env 와 같은 파서입니다).


# ═════════════════════════════════════════════════════════════════════
# 1. 단계
# ═════════════════════════════════════════════════════════════════════
#
#   단계            하는 일                    프로바이더
#   ────────────    ──────────────────────     ─────────────────────────
#   STORY           이야기 후보 4개            gemini · openai · anthropic
#   BOARD           콘티 (JSON)                gemini · openai · anthropic
#   SHEET           캐릭터 시트 사양 (JSON)    gemini · openai · anthropic
#   SHEET_IMAGE     캐릭터 시트 그림           gemini · openai
#   PAGE_IMAGE      페이지 그림 (페이지당 1회)  gemini · openai
#
# 값을 고르는 순서 — 위에 있는 것이 이깁니다:
#
#   <단계>_PROVIDER / <단계>_MODEL      이 단계만
#   NH_PROVIDER     / NH_MODEL          이 하네스 전체
#   PROVIDER                            story-harness 와 같은 기본값
#
# 그림 단계는 NH_MODEL 대신 NH_IMAGE_MODEL 을 봅니다 — 글 모델 이름을
# 그림 단계가 물려받으면 그대로 죽기 때문입니다.


# ── 하네스 전체 기본 ─────────────────────────────────────────────────
# 아래 단계별 줄을 하나도 안 켜면 전부 이 값으로 돕니다.
NH_PROVIDER=gemini

# 비우면 프로바이더의 기본 모델을 씁니다 (story-harness/.env 의
# GEMINI_MODEL / OPENAI_MODEL 을 물려받습니다).
# NH_MODEL=


# ── 단계마다 다른 모델 (필요한 줄만 켜세요) ──────────────────────────
#
# 예: 발상이 필요한 이야기 후보만 GPT 로 뽑고, 형식을 지켜야 하는 콘티는
#     Gemini 로 두고, 시트 사양은 Claude 로 —
#
# STORY_PROVIDER=openai
# STORY_MODEL=gpt-5.1
#
# BOARD_PROVIDER=gemini
# BOARD_MODEL=gemini-3-pro-preview
#
# SHEET_PROVIDER=anthropic
# SHEET_MODEL=claude-opus-5


# ── 그림 ─────────────────────────────────────────────────────────────
#
# ★ 프로바이더별 기본 이미지 모델을 **여기서 못 박습니다.**
#   story-harness/.env 에는 이 두 줄이 없어서, 안 적으면 story.py 의
#   맨 옛날 기본값(gemini-2.5-flash-image)으로 조용히 떨어집니다.
#   프로젝트의 다른 하네스(webtoon-harness/.env)가 쓰는 값과 맞춰 둡니다 —
#   같은 작품인데 하네스마다 다른 모델로 그리면 그림체가 갈립니다.
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
OPENAI_IMAGE_MODEL=gpt-image-2

# 어느 쪽으로 그릴지. gemini | openai
SHEET_IMAGE_PROVIDER=gemini
PAGE_IMAGE_PROVIDER=gemini

# 단계마다 다른 모델을 쓰고 싶을 때만 켭니다. 비우면 위의 프로바이더별
# 기본값을 씁니다.
#
# ★ 시트와 페이지를 **다른 모델로 두지 마세요.** 페이지를 그릴 때 시트를
#   참조 이미지로 붙이는 구조라, 시트를 그린 모델과 페이지를 그리는 모델이
#   다르면 참조가 오히려 그림체를 흔듭니다.
# SHEET_IMAGE_MODEL=
# PAGE_IMAGE_MODEL=

# openai 로 그릴 때만 봅니다. low | medium | high
# OPENAI_IMAGE_QUALITY=high


# ═════════════════════════════════════════════════════════════════════
# 2. 공통
# ═════════════════════════════════════════════════════════════════════

# 한 호출의 최대 출력 토큰. 콘티가 길면 여기서 끊깁니다 — 끊기면
# "응답이 길이 제한에서 끊겼습니다" 가 뜹니다.
NH_MAX_TOKENS=16000

# 창작 온도. 시트 사양만 코드가 0.4 로 낮춰 부릅니다 (사양은 발상이 아니라
# 받아쓰기라, 매번 달라지면 곤란합니다).
NH_TEMPERATURE=0.9

# 사진 한 장의 최대 크기(MB). 넘으면 줄여서 다시 넣으라고 멈춥니다.
# MAX_IMAGE_MB=5

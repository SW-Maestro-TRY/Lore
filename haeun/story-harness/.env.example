# 이 파일을 .env 로 복사해서 값을 채우세요.
#   cp .env.example .env
#
# 우선순위: 명령줄 인자 > 이미 설정된 환경변수 > 이 파일 > 코드 기본값
# .env 는 git 에 올리지 마세요 (.gitignore 에 들어 있습니다).


# ── 어느 프로바이더로 돌릴지 ─────────────────────────────────────
# gemini | openai | anthropic
PROVIDER=gemini


# ── Gemini (기본) ───────────────────────────────────────────────
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# 모델. Gemini 는 추론 모델도 temperature 를 받습니다.
# 확인된 것: gemini-3.5-flash · gemini-3.6-flash · gemini-3.1-pro-preview
#   gemini-flash-latest 는 자동으로 최신을 따라가지만, 실험 재현성을 위해
#   버전을 박아 쓰는 쪽을 권합니다 (meta.json 에 기록됩니다).
#   gemini-2.5-flash 는 신규 키로는 더 이상 호출되지 않습니다 (404).
GEMINI_MODEL=gemini-3.5-flash

# 심사 단계(P3 · 6단계) 전용 모델. 비워두면 GEMINI_MODEL 과 같습니다.
GEMINI_JUDGE_MODEL=

# 호환 게이트웨이를 쓸 때만
GEMINI_BASE_URL=


# ── OpenAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# 모델. temperature 통제가 필요하므로 비추론 모델을 권합니다.
# (o1 / o3 / o4 / gpt-5 계열은 temperature 를 받지 않습니다)
OPENAI_MODEL=gpt-4.1

# 심사 단계(P3 · 6단계) 전용 모델. 비워두면 OPENAI_MODEL 과 같습니다.
# 생성과 심사를 다른 모델로 돌리면 자기채점 편향을 한 겹 더 줄일 수 있습니다.
OPENAI_JUDGE_MODEL=

# ── 캐릭터 시트 (--charsheet) ─────────────────────────
# 시트 이미지는 기본이 **Gemini** 입니다. 컷을 Gemini 로 그리므로, 시트도 같은 모델로
# 뽑아야 그림체가 맞습니다 (아래 GEMINI_API_KEY / GEMINI_IMAGE_MODEL 을 씁니다 —
# webtoon-harness 와 같은 키·모델).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 비교용으로 OpenAI 로도 뽑을 수 있습니다: --charsheet --provider openai
# (gpt-image-1 은 2026-10-23 종료 예정이라 gpt-image-2 가 기본입니다)
OPENAI_IMAGE_MODEL=gpt-image-2

# 장당 단가(USD). 비워 두면 provider 별 기본 추정치를 씁니다
#   gemini : webtoon-harness config.yaml 의 cost_per_image_usd
#   openai : 1536x1024 medium 기준 $0.041 (다른 품질은 요금표 확인)
# 실제로 그린 장수와 합계는 charsheet/charsheet_meta.json 의 usage 에 남습니다.
IMAGE_COST_USD=

# 스타일 문구(style_suffix)를 읽어 올 webtoon-harness 위치.
# 비워 두면 story-harness 와 나란히 있는 ../webtoon-harness 를 봅니다.
# 시트와 컷의 스타일 문구가 다르면 --charsheet 가 경고합니다.
WEBTOON_HARNESS_DIR=

# Azure OpenAI 나 호환 게이트웨이를 쓸 때만
OPENAI_BASE_URL=


# ── Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_JUDGE_MODEL=
ANTHROPIC_BASE_URL=


# ── 텍스트 단가표 ───────────────────────────────────────────────
# 모델별 토큰 단가는 prices.json 에 있습니다 (100만 토큰당 USD).
# 여기 없는 모델을 쓰면 토큰은 그대로 세지만 비용은 '미상'으로 남습니다 —
# 모르는 단가를 0 으로 세면 합계가 조용히 낮아지기 때문입니다.
# 새 모델을 쓰면 요금표를 직접 보고 prices.json 에 한 줄 추가하세요.
# 다른 파일을 쓰려면 경로를 적으세요.
PRICES_FILE=prices.json


# ── 캐릭터 입력 (--character) ───────────────────────────────────
# 세계관 프리셋 파일. 캐릭터 JSON 의 world.preset 이 여기 키를 가리킵니다.
WORLDS_FILE=worlds.json

# 캐릭터 사진 한 장의 최대 크기(MB). 넘으면 API 400 전에 여기서 막습니다.
MAX_IMAGE_MB=5

# 장르·스토리 템플릿. 캐릭터의 genre 에 걸리는 것만 골라 P2 에 주입합니다.
# 매핑은 genre_template.json 의 _preset_map 에 있습니다.
# '대표작'·'참고자료'·examples 는 프롬프트에 넣지 않습니다 — 특정 작품의
# 제목과 줄거리를 모델에게 재료로 주면 그대로 베낄 위험이 있습니다.
GENRE_TEMPLATE_FILE=samples/genre_template.json
STORY_TEMPLATE_FILE=samples/story_templates.json


# ── 단계별 모델 덮어쓰기 (선택) ──────────────────────────────────
# 적으면 그 단계만 다른 모델로 돕니다. 비워두면 위 설정을 따릅니다.
# 스토리: LOOK SEED P1 P2 P3 SCENE CONTROL   /   웹툰: W4 W5 W6 W7
#   LOOK — 사진을 읽는 단계. 이미지를 받는 모델이어야 합니다.
#   SEED — 빠진 장르·세계관·한 줄을 채우는 단계.
# MODEL_P3=gpt-4.1
# MODEL_W6=gpt-4.1
# MODEL_LOOK=


# ── P3 게이트 ──────────────────────────────────────────────────
# no 여도 재생성을 부르지 않고 경고로만 기록할 체크 항목 (쉼표 구분).
# summary.csv 의 p3_warned_items 칸에 남습니다.
#
# 기본값이 sniping_verified 인 이유:
#   "B가 E(A)의 정확한 부정인가" 는 자연어로 물으면 판정 기준이 호출마다
#   달라져 사실상 모든 입력을 탈락시켰습니다. 저격 구조의 검증 가능한
#   부분은 이제 코드(gate_p1)가 P1 단계에서 판정하고, P3 에는 "두 단어가
#   반의어인가" 라는 어휘 판단만 남겨 경고로 씁니다.
# 다시 게이트로 쓰려면 빈 값으로 두세요: P3_ADVISORY_CHECKS=
P3_ADVISORY_CHECKS=sniping_verified


# ── 생성 파라미터 ───────────────────────────────────────────────
# 창작 단계(P1 P2 SCENE CONTROL W4 W5 W7)
TEMP_CREATIVE=0.9
# 심사 단계(P3 W6)
TEMP_JUDGE=0.2

MAX_TOKENS=8000

# 온도를 못 받는 모델에도 그냥 보내고 싶을 때 1
FORCE_TEMPERATURE=0

# OpenAI 의 JSON 모드. 프롬프트에 'json' 이 들어 있을 때만 자동으로 켜집니다.
OPENAI_JSON_MODE=1

# Gemini 의 JSON 모드(response_mime_type). 위와 같은 규칙으로 켜집니다.
GEMINI_JSON_MODE=1

# Gemini 의 사고(thinking). 사고 토큰이 MAX_TOKENS 를 갉아먹어 본문이 빈 채로
# 끊기는 것을 막기 위해 기본은 off 입니다.
#   off  = 끄기 (권장)
#   auto = 모델 기본값에 맡김
#   minimal | low | medium | high = Gemini 3.x 의 thinking_level
#   정수 = Gemini 2.x 의 thinking_budget (토큰 수)
#
# 세대마다 파라미터 이름이 달라(3.x=level, 2.x=budget) 서로의 값을 그대로 보내면
# 400 이 납니다. 코드가 모델 이름을 보고 맞는 쪽으로 번역하므로 그냥 off 로 두면 됩니다.
GEMINI_THINKING=off

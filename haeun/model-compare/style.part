<style>
/* 두 칸 대조: 왼쪽 기준선, 오른쪽 새 판. 같은 줄은 같은 자리(후보 n · 장면 n). 폰에서는 위아래로 쌓인다 */
:root {
  --bg: #faf7f7; --surface: #ffffff; --fg: #2a2326; --muted: #6f6468; --line: #e6dfe1;
  --base: #4f6272; --base-soft: #e7edf2; --new: #a33a5b; --new-soft: #f7e6ec; --warn: #9a5b00; --warn-soft: #fff1d6; --a: #6b5a2a; --a-soft: #f1ead6; --add: #2f7a4f; --add-soft: #e3f3e8; --del: #b23a3a; --del-soft: #f8e4e4;
  --display: "Noto Serif KR", "Apple SD Gothic Neo", serif;
  --body: "IBM Plex Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #1b1719; --surface: #252022; --fg: #ece5e8; --muted: #a89ba0; --line: #3a3235;
  --base: #9fb6c9; --base-soft: #263039; --new: #f08aa9; --new-soft: #3d2530; --warn: #f0b45a; --warn-soft: #3a2e1a; --a: #d9c27a; --a-soft: #332c18; --add: #6fcf97; --add-soft: #1f3a2a; --del: #f08080; --del-soft: #3e2222; color-scheme: dark } }
:root[data-theme="dark"] {
  --bg: #1b1719; --surface: #252022; --fg: #ece5e8; --muted: #a89ba0; --line: #3a3235;
  --base: #9fb6c9; --base-soft: #263039; --new: #f08aa9; --new-soft: #3d2530; --warn: #f0b45a; --warn-soft: #3a2e1a; --a: #d9c27a; --a-soft: #332c18; --add: #6fcf97; --add-soft: #1f3a2a; --del: #f08080; --del-soft: #3e2222; color-scheme: dark }
body { background: var(--bg); color: var(--fg); font: 15px/1.7 var(--body); }
.wrap { max-width: 1180px; margin: 0 auto; padding-inline: 20px; padding-block: 40px 80px; display: grid; gap: 40px; }
h1, h2 { font-family: var(--display); text-wrap: balance; margin: 0; }
h1 { font-size: 1.9rem; line-height: 1.3; }
h2 { font-size: 1.35rem; }
header p, .lede { color: var(--muted); max-width: 68ch; margin: 8px 0 0; }
.meta { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 14px; font-size: .85rem; color: var(--muted); font-variant-numeric: tabular-nums; }
.meta b { color: var(--fg); font-weight: 600; }
.findings { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
.finding { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px 20px; min-width: 0; }
.finding h3 { margin: 0 0 8px; font-size: 1rem; }
.finding ul { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; }
.finding.warn { border-color: var(--warn); background: var(--warn-soft); }
section { display: grid; gap: 14px; }
.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.pair.three { grid-template-columns: repeat(3, 1fr); }
.tag.a { color: var(--a); background: var(--a-soft); }
.cell { min-width: 0; display: grid; gap: 6px; align-content: start; }
.tag { justify-self: start; font-size: .72rem; font-weight: 600; letter-spacing: .04em; padding: 2px 8px; border-radius: 999px; }
.tag.base { color: var(--base); background: var(--base-soft); }
.tag.new { color: var(--new); background: var(--new-soft); }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; min-width: 0; }
.card.dropped { border-color: var(--warn); }
.card h4 { margin: 0 0 8px; font-size: .98rem; font-weight: 600; }
.card p { margin: 0; }
.intro { color: var(--fg); }
details { margin-top: 10px; color: var(--muted); }
summary { cursor: pointer; font-size: .85rem; font-weight: 500; }
details p { margin-top: 6px; color: var(--fg); }
dl { margin: 0; display: grid; gap: 4px; }
dt { font-size: .75rem; font-weight: 600; color: var(--muted); letter-spacing: .03em; margin-top: 8px; }
dd { margin: 0; }
.next { background: var(--surface); border: 1px solid var(--new); border-radius: 12px; padding: 20px; }
.diff { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
.diff summary { padding: 8px 12px; background: var(--bg); font-family: ui-monospace, Menlo, monospace; color: var(--fg); }
.hunk { overflow-x: auto; border-top: 1px solid var(--line); padding-block: 6px; }
.ln { white-space: pre-wrap; font-size: .86rem; line-height: 1.6; padding-inline: 12px 8px; border-left: 3px solid transparent; }
.ln.ctx { color: var(--muted); }
.ln.add { background: var(--add-soft); border-left-color: var(--add); }
.ln.del { background: var(--del-soft); border-left-color: var(--del); text-decoration: line-through; text-decoration-color: var(--del); color: var(--muted); }
.ask { background: var(--new-soft); border-radius: 8px; padding: 14px 16px; }
.ask h3 { margin: 0 0 6px; font-size: 1rem; }
.ask ul { margin: 0 0 6px; padding-left: 1.1em; }
.ask p { margin: 0; color: var(--muted); font-size: .9rem; }
.flag { font-size: .85rem; color: var(--warn); background: var(--warn-soft); padding: 6px 10px; border-radius: 6px; margin-bottom: 6px !important; }
@media (max-width: 960px) { .pair.three { grid-template-columns: 1fr; } }
@media (max-width: 760px) { .pair { grid-template-columns: 1fr; } .wrap { padding-inline: 16px; } }
</style>

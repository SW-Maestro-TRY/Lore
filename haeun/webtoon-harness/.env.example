# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 에 있음)
# 모델 이름은 여기에만 있습니다. config.yaml 에는 실험 조건만 둡니다.

# 텍스트 LLM 과 이미지 모델이 같은 키를 씁니다.
GEMINI_API_KEY=여기에_키를_넣으세요

# prompt_gen / cut_split 용 텍스트 모델 (story-harness 와 같은 계열)
GEMINI_TEXT_MODEL=gemini-3.5-flash

# render 용 이미지 모델 (char-harness 와 같은 모델)
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

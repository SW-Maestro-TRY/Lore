# Lore 로컬 스택(scripts/dev.sh) 기본값. 비밀이 아니다 — 로컬 컨테이너 안에서만 쓰는 예시값이다.
#
# 바꾸고 싶으면 이 파일을 고치지 말고 같은 폴더에 .env.dev.local 을 만들어 바꿀 줄만 적는다
# (.env.dev.local 은 .gitignore 의 .env.*.local 에 걸려 커밋되지 않는다). 뒤에 읽는 쪽이 이긴다.
#
# 포트·JWT_SECRET·SITE_URL·S3_PUBLIC_URL 은 dev.sh 가 스택마다 채우므로 여기 적지 않는다.

# ── 테스트 계정 ── `dev.sh up` 이 없으면 만들고 있으면 건너뛴다(볼륨이 남아 있는 한 계속 같다).
DEV_USER_EMAIL=dev@lore.test
DEV_USER_PASSWORD=lore-dev-1234
DEV_PET_NAME=테스트여울
# 관리자 계정(role=ADMIN). 관리자 화면(/zzal/admin) 확인용.
DEV_ADMIN_EMAIL=admin@lore.test
DEV_ADMIN_PASSWORD=lore-admin-1234

# ── DB·MinIO (컨테이너 안에서만 쓰는 값) ──
DB_USERNAME=lore
DB_PASSWORD=lore-local-dev
S3_ACCESS_KEY=lore-minio
S3_SECRET_KEY=lore-minio-secret
CONTENT_BUCKET=lore-content
AWS_REGION=ap-northeast-2

# ── 로컬 기본 켜짐 ── 리모컨(dev API /api/zzal/v1/dev/**)·관리자 화면. 로컬 DB 엔 남의 데이터가 없다.
ZZAL_DEV_TOOLS=true
ZZAL_ADMIN=true

# ── 돈 나가는 스위치(기본 꺼짐) ──
# OPENAI_KEY 를 채우고 ZZAL_GENERATION_REAL=true 로 바꾸는 순간 부화마다 과금된다.
OPENAI_KEY=
ZZAL_GENERATION_REAL=false
ZZAL_REAL_POSTPROCESS=false

# Ordinary generation attempts per request (1 or 2); production default remains 2.
ZZAL_CHAT_MAX_ATTEMPTS=2

# ── 웹툰 만들기(선택) ──
WEBTOON_API_KEY=
LORE_WEBTOON_INTERNAL_TOKEN=
NH_PROVIDER=openai

# ── 기타(선택) ──
NEXT_PUBLIC_KAKAO_JS_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=

# Diary is opt-in; enabling it can issue paid requests using the existing OpenAI key.
ZZAL_DIARY_ENABLED=false
ZZAL_DIARY_TIMEOUT_MS=15000
ZZAL_DIARY_SWEEP_MS=30000
# Blank keeps the existing uncapped payload; use 1024 only for approved isolated measurement.
ZZAL_DIARY_MAX_COMPLETION_TOKENS=

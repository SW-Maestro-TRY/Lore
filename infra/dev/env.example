# Lore 개발 스택(docker compose) 환경변수 본보기.
#
#   cp infra/dev/env.example infra/dev/.env     ← .env 는 절대 커밋하지 않는다(.gitignore + 훅이 막는다)
#
# 아래 값은 **노트북 기본값**이다. 그대로 두면 `docker compose --env-file infra/dev/.env up --build`
# 만으로 스택이 뜬다. dev EC2(박스)에서 달라지는 줄에는 「박스:」 로 표시해 뒀다.
# 박스의 진짜 .env 는 /opt/lore-dev/.env 에만 있고 배포가 절대 덮지 않는다.

# ── 환경 이름 ────────────────────────────────────────────────────
# 앱이 자기가 어느 환경인지 아는 이름(로그·분기용). compose 는 app 에 LORE_ENV=dev 를 직접
# 박으므로 이 값은 사람이 읽는 표시에 가깝다. 박스에서도 dev 그대로 둔다.
LORE_ENV=dev

# ── DB (RDS 대체 · postgres 컨테이너) ────────────────────────────
# compose 가 postgres 컨테이너를 이 계정으로 만들고, 앱도 같은 값으로 붙는다.
# 아무 값이나 돼도 되지만 둘이 같아야 한다(한 변수에서 양쪽으로 간다).
DB_USERNAME=lore
DB_PASSWORD=lore-local-dev

# ── 오브젝트 스토리지 (S3 대체 · MinIO) ──────────────────────────
# MinIO 루트 계정. 앱은 이 값을 AWS_ACCESS_KEY_ID/SECRET 으로 받아 MinIO 에 붙는다.
# 박스: 아무도 못 맞추는 값으로 바꾼다(9000 포트가 nginx 뒤에 있긴 하다).
S3_ACCESS_KEY=lore-minio
S3_SECRET_KEY=lore-minio-secret

# 콘텐츠 버킷 이름. 운영의 CONTENT_S3_BUCKET 자리다.
# ★ infra/dev/nginx.conf 의 /lore-content/ · /images/ 경로에 이 이름이 리터럴로 박혀 있다.
#   nginx 는 env 치환을 하지 않으므로, 이 값을 바꾸면 nginx.conf 도 같이 바꿔야 한다.
CONTENT_BUCKET=lore-content

# presigned URL 이 계산되는 "공개 주소". 브라우저가 실제로 닿는 주소와 같아야 한다.
#   노트북 = MinIO 를 직접 부른다(9000)
#   박스   = nginx 뒤 한 도메인 아래로 묶는다
# 박스: S3_PUBLIC_URL=https://dev.lorecomic.com
S3_PUBLIC_URL=http://localhost:9000

# SDK 가 요구하는 리전 이름. MinIO 는 리전을 안 보지만 비면 클라이언트가 못 뜬다.
AWS_REGION=ap-northeast-2

# ── 쿠키 ─────────────────────────────────────────────────────────
# Secure 쿠키는 https 에서만 저장된다. http 인 노트북에서 true 로 두면 로그인이 안 붙는다.
# 박스: COOKIE_SECURE=true
COOKIE_SECURE=false

# ── zzal 생성 (돈이 나가는 스위치) ───────────────────────────────
# 비워 두면 가짜 모드로 뜬다 — 결제 없이 화면·API 개발이 된다.
OPENAI_KEY=

# 실제 OpenAI 호출 스위치(app.zzal.generation.real). 키가 있어도 이 값이 false 면 가짜 모드다.
# ★ true 로 바꾸는 순간 부화 한 바퀴마다 과금된다. 기본은 끈 채로 둔다.
ZZAL_GENERATION_REAL=false

# 파이썬 후처리(격자 → 8종 움짤) 실제 실행. 돈은 안 나가지만 numpy·scipy·pillow 가 필요하다.
# infra/dev/Dockerfile.api 가 이미지 안에 파이썬을 심어 두므로 켜도 뜬다(기본은 꺼짐).
ZZAL_REAL_POSTPROCESS=false

# ── 공유 링크 ────────────────────────────────────────────────────
# 만들어진 공유 링크의 기준 주소. 노트북은 프론트가 3100 이므로 그대로 둔다.
# 박스: ZZAL_SHARE_BASE_URL=https://dev.lorecomic.com/zzal/s
ZZAL_SHARE_BASE_URL=http://localhost:3100/zzal/s

# ── 메일 ─────────────────────────────────────────────────────────
# 비워도 스택은 뜬다(compose 가 메일 헬스 검사를 끈다). 메일 발송을 개발할 때만 채운다.
MAIL_USERNAME=
MAIL_PASSWORD=

# ── 정적 그림 씨뿌리기 ───────────────────────────────────────────
# 첫 기동에 infra/dev/seed-assets.txt 의 키(118개)를 이 주소에서 그대로 받아 MinIO 에 넣는다.
# 공개 CloudFront 라 AWS 자격이 필요 없고, 못 받아도 스택은 뜬다(그림만 빈다).
SEED_BASE_URL=https://staging.lorecomic.com

# Lore 개발 스택(docker compose) 환경변수 본보기.
#
#   cp infra/dev/env.example infra/dev/.env     ← .env 는 절대 커밋하지 않는다(.gitignore + 훅이 막는다)
#
# 아래 값은 **노트북 기본값**이다. 그대로 두면 `docker compose --env-file infra/dev/.env up --build`
# 만으로 스택이 뜬다. dev EC2(박스)에서 달라지는 줄에는 「박스:」 로 표시해 뒀다.
# 박스의 진짜 .env 는 /opt/lore-dev/.env 에만 있고 배포가 절대 덮지 않는다.

# ── 환경 이름 ────────────────────────────────────────────────────
# 앱이 자기가 어느 환경인지 아는 이름(로그·분기용). compose 는 app 에 LORE_ENV=dev 를 직접
# 박으므로 이 값은 사람이 읽는 표시에 가깝다. 박스에서도 dev 그대로 둔다.
LORE_ENV=dev

# ── DB (RDS 대체 · postgres 컨테이너) ────────────────────────────
# compose 가 postgres 컨테이너를 이 계정으로 만들고, 앱도 같은 값으로 붙는다.
# 아무 값이나 돼도 되지만 둘이 같아야 한다(한 변수에서 양쪽으로 간다).
DB_USERNAME=lore
DB_PASSWORD=lore-local-dev

# ── 오브젝트 스토리지 (S3 대체 · MinIO) ──────────────────────────
# MinIO 루트 계정. 앱은 이 값을 AWS_ACCESS_KEY_ID/SECRET 으로 받아 MinIO 에 붙는다.
# 박스: 아무도 못 맞추는 값으로 바꾼다(9000 포트가 nginx 뒤에 있긴 하다).
S3_ACCESS_KEY=lore-minio
S3_SECRET_KEY=lore-minio-secret

# 콘텐츠 버킷 이름. 운영의 CONTENT_S3_BUCKET 자리다.
# ★ infra/dev/nginx.conf 의 /lore-content/ · /images/ 경로에 이 이름이 리터럴로 박혀 있다.
#   nginx 는 env 치환을 하지 않으므로, 이 값을 바꾸면 nginx.conf 도 같이 바꿔야 한다.
CONTENT_BUCKET=lore-content

# presigned URL 이 계산되는 "공개 주소". 브라우저가 실제로 닿는 주소와 같아야 한다.
#   노트북 = MinIO 를 직접 부른다(9000)
#   박스   = nginx 뒤 한 도메인 아래로 묶는다
# 박스: S3_PUBLIC_URL=https://dev.lorecomic.com
S3_PUBLIC_URL=http://localhost:9000

# SDK 가 요구하는 리전 이름. MinIO 는 리전을 안 보지만 비면 클라이언트가 못 뜬다.
AWS_REGION=ap-northeast-2

# ── 쿠키 ─────────────────────────────────────────────────────────
# Secure 쿠키는 https 에서만 저장된다. http 인 노트북에서 true 로 두면 로그인이 안 붙는다.
# 박스: COOKIE_SECURE=true
COOKIE_SECURE=false

# ── zzal 생성 (돈이 나가는 스위치) ───────────────────────────────
# 비워 두면 가짜 모드로 뜬다 — 결제 없이 화면·API 개발이 된다.
OPENAI_KEY=

# 실제 OpenAI 호출 스위치(app.zzal.generation.real). 키가 있어도 이 값이 false 면 가짜 모드다.
# ★ true 로 바꾸는 순간 부화 한 바퀴마다 과금된다. 기본은 끈 채로 둔다.
ZZAL_GENERATION_REAL=false

# 파이썬 후처리(격자 → 8종 움짤) 실제 실행. 돈은 안 나가지만 numpy·scipy·pillow 가 필요하다.
# infra/dev/Dockerfile.api 가 이미지 안에 파이썬을 심어 두므로 켜도 뜬다(기본은 꺼짐).
ZZAL_REAL_POSTPROCESS=false

# Ordinary generation attempts per request (1 or 2); production default remains 2.
ZZAL_CHAT_MAX_ATTEMPTS=2

# Optional identity verification cap; leave empty for the existing production contract.
ZZAL_OPENAI_IDENTITY_MAX_COMPLETION_TOKENS=

# Custom planner/provider and dispatcher are independently opt-in. No runtime activation by this example.
ZZAL_ATTENDANCE_CLI_ENABLED=false
ZZAL_CUSTOM_ENABLED=false
ZZAL_CUSTOM_PLANNER_MODEL=gpt-5.6-luna
ZZAL_CUSTOM_PLANNER_REASONING_EFFORT=none
ZZAL_CUSTOM_PLANNER_MAX_COMPLETION_TOKENS=6144
ZZAL_CUSTOM_PLANNER_TIMEOUT_SECONDS=90
ZZAL_CUSTOM_PROVIDER=
ZZAL_CUSTOM_IMAGE_MODEL=gpt-image-2
ZZAL_CUSTOM_IMAGE_SIZE=1248x1248
ZZAL_CUSTOM_POSTPROCESS_VERSION=v1
ZZAL_CUSTOM_DISPATCH_ENABLED=false
# Private named volume in docker-compose.yml; do not use /tmp for recoverable work.
ZZAL_CUSTOM_DISPATCH_OUTPUT_ROOT=/var/lib/lore/custom-bundles

# One-shot publication recovery uses the same private output root. Keep disabled by default.
ZZAL_PUBLICATION_RECOVERY_ENABLED=false
ZZAL_PUBLICATION_RECOVERY_OWNER_ID=
ZZAL_PUBLICATION_RECOVERY_JOB_ID=
ZZAL_PUBLICATION_RECOVERY_OPERATION_ID=
ZZAL_PUBLICATION_RECOVERY_EXPIRES_AT=

# Diary uses the ordinary chat model/key. Enabling it also processes existing eligible pets.
ZZAL_DIARY_ENABLED=false
ZZAL_DIARY_TIMEOUT_MS=15000
ZZAL_DIARY_SWEEP_MS=30000
ZZAL_DIARY_MAX_COMPLETION_TOKENS=

# ── 리모컨(dev API)·관리자 화면 ──────────────────────────────────
# 꺼져 있으면 /api/zzal/v1/dev/** 와 /api/zzal/v1/admin/** 가 아예 없다(404). 노트북은 켜도 된다.
# 박스: ZZAL_DEV_TOOLS=true · ZZAL_ADMIN=true (운영·스테이징엔 이 키를 두지 않는다)
ZZAL_DEV_TOOLS=false
ZZAL_ADMIN=false
# 관리자 봇(맥미니 러너) — 32자 이상 토큰 + 관리자 계정 번호. 비우면 봇 문만 꺼진다.
ZZAL_ADMIN_TOKEN=
ZZAL_ADMIN_BOT_USER_ID=

# ── 웹툰 만들기 ──────────────────────────────────────────────────
# 하네스를 돌릴 파이썬. 이미지 안에 zzal 것(/opt/lore/venv)과 별개로 심어 둔 두 번째
# 가상환경이고, staging·prod 박스도 같은 경로다. 보통 건드릴 일이 없다.
LORE_WEBTOON_PYTHON_BIN=/opt/lore/venv-webtoon/bin/python

# 하네스가 그림·이야기를 부를 때 쓰는 열쇠(OpenAI). 자바가 파이썬에 물려주고
# llm.py 가 OPENAI_API_KEY 로 풀어 쓴다. 비워 두면 만들기가 첫 걸음에서 멈춘다.
# ★ 하은님 제공값 — 추측해서 채우지 않는다.
WEBTOON_API_KEY=

# 하네스가 다 그린 그림을 올리고 비용을 적을 때 서버에 대는 한 마디(아스키만).
# 비어 있어도 스택은 뜨지만 S3 에만 올라가고 주소가 DB 에 안 적힌다.
# ★ 하은님 제공값.
LORE_WEBTOON_INTERNAL_TOKEN=

# new_harness 모델 프로바이더. dev 는 글·그림 모두 OpenRouter 를 거친다(모델은 같은
# OpenAI 모델에 openai/ 만 붙음). 되돌리려면 openai 로 바꾸고 app 을 다시 띄운다.
# WEBTOON_API_KEY 는 그대로 둔다 — 입력 글 검사(moderation)가 계속 OpenAI 로 간다.
NH_PROVIDER=openrouter
# ★ 하은님 제공값 — 추측해서 채우지 않는다.
OPENROUTER_API_KEY=
# 채우면 검수 네 단계가 Gemini 로 간다. 비우면 검수도 위 NH_PROVIDER 를 따른다.
GEMINI_API_KEY=
# 운영 알림 디스코드 웹훅(#831). 비우면 알림만 꺼진다. ★ 하은님 제공값.
LORE_WEBTOON_ALERT_DISCORD_WEBHOOK=
# 스토리 축 기능(기본 켜짐) · 스토리 엔진 실험 기능(기본 꺼짐). 필요할 때만 바꾼다.
NH_STORY_AXES=
NH_STORY_ENGINES=

# 완성 알림 메일 안의 링크가 가리킬 기준 주소. 노트북은 프론트가 3100 이다.
# 박스: LORE_WEBTOON_SITE_URL=https://dev.lorecomic.com
LORE_WEBTOON_SITE_URL=http://localhost:3100

# ── 공유 링크 ────────────────────────────────────────────────────
# 만들어진 공유 링크의 기준 주소. 노트북은 프론트가 3100 이므로 그대로 둔다.
# 박스: ZZAL_SHARE_BASE_URL=https://dev.lorecomic.com/zzal/s
ZZAL_SHARE_BASE_URL=http://localhost:3100/zzal/s

# ── 메일 ─────────────────────────────────────────────────────────
# 비워도 스택은 뜬다(compose 가 메일 헬스 검사를 끈다). 메일 발송을 개발할 때만 채운다.
MAIL_USERNAME=
MAIL_PASSWORD=
# 받는 사람에게 보이는 보낸사람. 비우면 MAIL_USERNAME 으로 나간다.
# 주소와 이름을 따로 넣는다(공백·< 가 든 값은 서버 env 파일에서 깨진다). 예: lore@lorecomic.com · LORE
MAIL_FROM=
MAIL_FROM_NAME=

# ── 카카오 공유 ──────────────────────────────────────────────────
# 웹툰 공유 버튼(webtoon/fe/lib/share.ts)이 읽는 JS 키. Next.js 가 빌드 시점에
# 번들에 박아 넣으므로(docker-compose.yml web 서비스 build.args) 값을 바꾸면
# `docker compose up -d --build web` 로 다시 빌드해야 반영된다. 비우면 공유 버튼만 꺼진다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 정적 그림 씨뿌리기 ───────────────────────────────────────────
# 첫 기동에 infra/dev/seed-assets.txt 의 키(127개)를 이 주소에서 그대로 받아 MinIO 에 넣는다.
# 공개 CloudFront 라 AWS 자격이 필요 없고, 못 받아도 스택은 뜬다(그림만 빈다).
SEED_BASE_URL=https://staging.lorecomic.com

# Diary is opt-in; enabling it can issue paid requests using the existing OpenAI key.
ZZAL_DIARY_ENABLED=false
ZZAL_DIARY_TIMEOUT_MS=15000
ZZAL_DIARY_SWEEP_MS=30000
# Blank keeps the existing uncapped payload; use 1024 only for approved isolated measurement.
ZZAL_DIARY_MAX_COMPLETION_TOKENS=

# Private metrics. No provider requests; one resource snapshot per minute.
ZZAL_METRICS_RUNTIME_ENABLED=true
ZZAL_METRICS_RUNTIME_INTERVAL_MS=60000
ZZAL_METRICS_QUEUE_ENABLED=true
# Keep this inside the dedicated compose volume. An empty application setting is memory-only.
ZZAL_METRICS_SPOOL_DIRECTORY=/var/lib/lore/metrics-spool

# PM 전용 설정. 실제 값은 운영 환경에만 보관한다. 이 파일을 자동 적용하지 않는다.
# 배포 후 설정·전송 항목 검토와 시험을 거쳐 별도로 활성화한다.
PIECE_MAKER_META_ENABLED=false
PIECE_MAKER_META_PIXEL_ID=
# https://호스트 형태이며 끝에 /를 붙이지 않는다. 시험용 픽셀과 운영용을 분리한다.
PIECE_MAKER_META_SITE_ORIGIN=

# 자동 삭제와 시험 계정 검토 완료도 실제 적용·검증 전에는 꺼 둔다.
PIECE_MAKER_RETENTION_ENABLED=false
PIECE_MAKER_TEST_USER_IDS=
PIECE_MAKER_TEST_EXCLUSIONS_REVIEWED=false
# 실제 연속 수집을 검증한 과거 구간만 ISO-8601 UTC로 입력한다. 미래 시각 금지.
PIECE_MAKER_HISTORY_VERIFIED_FROM=
PIECE_MAKER_HISTORY_VERIFIED_THROUGH=
